# ── vocabulary-service ────────────────────────────────────────────────────
# Copy to `.env` and fill in. Vars marked (required) are validated at boot
# (src/config/validate-env.ts) — the service will refuse to start without them.

# HTTP port (defaults to 3002).
PORT=3002

# Comma-separated list of allowed CORS origins.
CORS_ENABLED_ORIGINS=http://localhost:4000

# (required) PostgreSQL connection string.
DATABASE_URL=postgresql://wordsly:wordsly@localhost:5432/vocabulary?schema=public

# (required) Redis connection string.
REDIS_URL=redis://localhost:6379


# ── Kafka (optional; leave empty to disable) ──────────────────────────────────
KAFKA_BROKERS=
KAFKA_CA=
KAFKA_CERT=
KAFKA_KEY=

# ── Identity verification (added by the auth migration) ───────────────────────
# (required) Where to fetch auth-service's published signing keys. This is the
# INTERNAL address: the issuer below is the public one tokens claim, but keys
# are fetched directly rather than hairpinning back through the gateway.
AUTH_JWKS_URI=http://localhost:3001/.well-known/jwks.json
# (required) Issuer string tokens must carry, compared exactly. Public URL.
JWT_ISSUER=http://localhost:3000
# Audience for access tokens. Refresh tokens carry a different one, which is
# what stops a refresh token being spent as an access token here.
JWT_AUDIENCE=wordsly-api
