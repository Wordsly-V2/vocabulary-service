// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id          String  @id @db.Uuid
  name        String
  coverImageUrl String?

  userLoginId      String?  @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  lessons Lesson[]

  @@map("courses")
}

model Lesson {
  id          String  @id @db.Uuid
  name        String
  coverImageUrl String?
  maxWords      Int?
  orderIndex    Int?

  courseId    String  @db.Uuid
  course      Course  @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  words Word[]

  @@map("lessons")
}

model Word {
  id          String  @id @db.Uuid
  word        String
  meaning     String
  pronunciation String?
  partOfSpeech    String?
  audioUrl    String?

  lessonId    String  @db.Uuid
  lesson      Lesson  @relation(fields: [lessonId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  wordProgress WordProgress[]

  @@map("words")
}

// Spaced Repetition tracking using SM-2 algorithm
model WordProgress {
  id          String  @id @db.Uuid
  
  // References
  wordId      String  @db.Uuid
  word        Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  userLoginId String  @db.Uuid
  
  // SM-2 Algorithm fields
  easeFactor  Float   @default(2.5)  // How easy the word is (2.5 is default)
  interval    Int     @default(0)     // Days until next review (0 = new card)
  repetitions Int     @default(0)     // Number of consecutive correct answers
  
  // Review tracking
  lastReviewedAt DateTime?  @map("last_reviewed_at") @db.Timestamptz
  nextReviewAt   DateTime   @default(now()) @map("next_review_at") @db.Timestamptz
  
  // Statistics
  totalReviews    Int @default(0) @map("total_reviews")
  correctReviews  Int @default(0) @map("correct_reviews")
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([wordId, userLoginId])
  @@index([userLoginId, nextReviewAt])
  @@index([wordId])
  @@map("word_progress")
}